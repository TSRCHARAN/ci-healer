# Copy to .env and fill in. .env is git-ignored.

# ---------------------------------------------------------------- LLM ----
# Provider: anthropic | gemini | groq | openai | openrouter | mistral | deepseek |
#           together | ollama | openai_compatible
LLM_PROVIDER=anthropic

# Model id for that provider. Optional for anthropic (defaults to claude-opus-5-5),
# required for the rest. List what your key can use with:  ci-healer models
LLM_MODEL=

# The key. If empty, falls back to the provider's usual variable
# (ANTHROPIC_API_KEY, GEMINI_API_KEY / GOOGLE_API_KEY, GROQ_API_KEY, OPENAI_API_KEY,
#  OPENROUTER_API_KEY, MISTRAL_API_KEY, DEEPSEEK_API_KEY, TOGETHER_API_KEY). Ollama needs none.
LLM_API_KEY=

# Only for openai_compatible (vLLM, LM Studio, a gateway...) or to route through a proxy.
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MAX_TOKENS=8192

# ------------------------------------------------------------- GitHub ----
# For dogfooding, a fine-grained PAT scoped to ONE repo with:
#   Actions: read & write (read logs, re-run jobs)
#   Contents: read & write (create fix branches)
#   Pull requests: read & write (open fix PRs, comment)
# Deliberately NOT "Workflows" — without it GitHub itself refuses any edit to .github/workflows/.
GITHUB_TOKEN=

# Shared secret you also paste into the repo's webhook settings.
GITHUB_WEBHOOK_SECRET=

# ------------------------------------------------------------- safety ----
# Only these repos are acted on (comma-separated owner/name). Empty = refuse all.
CI_HEALER_ALLOWED_REPOS=

# Shadow mode: classify and record what it WOULD do, but never re-run or open PRs.
CI_HEALER_DRY_RUN=true

# Optional knobs (defaults shown)
# CI_HEALER_DB=ci_healer.db
# CI_HEALER_MAX_RERUNS=1
# CI_HEALER_AUTOFIX=true
# CI_HEALER_MAX_FIX_FILES=3
# CI_HEALER_MAX_FIX_LINES=40
# CI_HEALER_MIN_FIX_CONFIDENCE=0.8
# CI_HEALER_COMMENT_ON_PRS=false
